-- Selector de Tecla
keybindButton.MouseButton1Click:Connect(function()
    if listeningForInput then return end
    listeningForInput = true
    keybindButton.Text = "KEY: ..."
end)

UserInputService.InputBegan:Connect(function(input, gp)
    if listeningForInput and not gp and input.KeyCode ~= Enum.KeyCode.Unknown then
        keybind = input.KeyCode
        actualizarKeybindButton()
        listeningForInput = false
    elseif not gp and (input.KeyCode == keybind) then
        toggleLagger()
    end
end)

-- Botones Low/Mid/High
local btnY, btnW, btnH, esp = 46, 50, 20, 5
local function crearBtn(txt, pos, nivel)
    local b = Instance.new("TextButton", mainFrame)
    b.Size = UDim2.new(0, btnW, 0, btnH)
    b.Position = pos
    b.Font = UI_CONFIG.Font
    b.Text = txt
    b.TextSize = 9
    b.AutoButtonColor = false
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    b.MouseButton1Click:Connect(function() nivelActual = nivel; actualizarBotonesNivel(); SaveConfig() end)
    return b
end
btnLow = crearBtn("LOW", UDim2.new(0, 5, 0, btnY), "Low")
btnMid = crearBtn("MID", UDim2.new(0, 5 + btnW + esp, 0, btnY), "Mid")
btnHigh = crearBtn("HIGH", UDim2.new(0, 5 + (btnW + esp) * 2, 0, btnY), "High")
actualizarBotonesNivel()
